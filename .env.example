# Copilot API Configuration

# Server Port
PORT=4141

# Bind address. Use 127.0.0.1 when serving behind nginx; use 0.0.0.0 only if exposing directly.
# HOST=127.0.0.1

# API Key for Bearer token authentication
# If set, all API calls must include: Authorization: Bearer <API_KEY>
API_KEY=your-api-key-here

# Admin Dashboard Password
# If not set, defaults to API_KEY
# Used for /admin/login access
ADMIN_PASSWORD=your-admin-password-here

# GitHub Token (skip auth prompt if provided)
# Generate via: bunx copilot-api auth
# GITHUB_TOKEN=ghp_xxxxx

# Account Type: individual, business, or enterprise
ACCOUNT_TYPE=individual

# Multi-account L0 routing — defaults maximize prompt-cache utilization
# ROUTING_STRATEGY=fill-first    # fill-first (default, best cache) | round-robin
# SESSION_AFFINITY=true          # stick session → credential (default true)
# IDENTITY_CONFUSE=false         # Codex L1 only; needs affinity or fill-first

# Enable verbose logging
VERBOSE=false

# Persist debug-level lines to server.log without enabling verbose console output
# LOG_FILE_DEBUG=true

# Rotated file logs live under ~/.local/share/copilot-api/logs/
# server-YYYY-MM-DD.log (auto-rotates when a file exceeds 10MB)
# LOG_MAX_FILE_BYTES=10485760
# LOG_RETENTION_DAYS=7
# LOG_DIR=

# Bun heap ceiling, in MB. Without one, JSC sizes its heap from total system
# RAM and a 1 GiB host can be pushed into the OOM killer under load.
#
# IMPORTANT: this one is only honoured when it reaches Bun as a real shell
# environment variable, because it turns into the `--smol` flag plus
# BUN_JSC_forceRAMSize, and JSC reads both while sizing the heap — before Bun
# parses this file. Putting it here works with ./start-dev.sh (which sources
# .env into the shell before launching) but NOT with a bare `bun run`.
#   docker:      docker run -e BUN_MEMORY_LIMIT_MB=512 ...  (entrypoint.sh
#                already defaults to 512, so this is only to override it)
#   start-dev:   set it here, or export it
#   bare bun:    BUN_JSC_forceRAMSize=$((512*1024*1024)) bun --smol run ...
# Set 0 to opt out.
# BUN_MEMORY_LIMIT_MB=512

# Windsurf buffer ceilings — lower these on a small host. They bound the worst
# case per in-flight request, not the steady state.
# WINDSURF_MAX_FRAME_MB=4        # scales the 16/32 MB connect-frame limits
# WINDSURF_MAX_RESPONSE_MB=8     # non-streaming response held in memory (max 32)

# Linux/Bun memory and swap diagnostics (enabled by default).
# Set verbose=true temporarily to persist per-stage request checkpoints. Logs
# include byte counts and memory metrics only, never request text or secrets.
# MEMORY_DIAGNOSTICS=true
# MEMORY_DIAGNOSTICS_VERBOSE=false
# MEMORY_DIAGNOSTICS_INTERVAL_MS=15000
# MEMORY_DIAGNOSTICS_PROCESS_MB=512
# MEMORY_DIAGNOSTICS_SWAP_MB=64
# MEMORY_DIAGNOSTICS_AVAILABLE_MB=128
# MEMORY_DIAGNOSTICS_EVENT_LOOP_LAG_MS=1000
# MEMORY_DIAGNOSTICS_SWAP_PAGES_PER_SECOND=256
# MEMORY_DIAGNOSTICS_PSI_AVG10=5

# Windsurf stream resilience and auth caching
# Time from upstream HTTP 200 until the first forwardable model event. Set 0
# to disable. A timeout cancels the upstream body before retry/failover.
# WINDSURF_FIRST_FRAME_TIMEOUT_MS=60000
# Optional same-account retries before dispatch tries another account (0-2).
# Retries may consume another Windsurf message, so the default is 0.
# WINDSURF_FIRST_FRAME_RETRIES=0
# In-memory GetUserJwt cache TTL. The JWT exp claim minus a safety margin always
# wins; auth failures invalidate the entry. Set 0 to fetch on every request.
# WINDSURF_USER_JWT_CACHE_TTL_MS=60000
# Maximum simultaneous Windsurf requests per account. Set 1 for a 1 GiB VPS;
# set 0 to disable the guard, or increase up to 16 when memory allows.
# WINDSURF_MAX_CONCURRENT_REQUESTS=2
# Chat SSE responses emit an immediate `: connected` comment and keep-alive
# comments every 5 seconds. Per-account Windsurf concurrency is logged with
# streaming/non-streaming counts; overlaps are WARN-level events.

# Mimo AI Studio configuration
# The public WebSocket URL where cloud Claw containers can connect back to this instance.
# Required if you want Claw agents to tunnel requests back (e.g. wss://api.yourdomain.com/ws/mimo).
# If running locally behind tunnel/proxy, set this to the public tunnel address.
# MIMO_WS_URL=ws://localhost:4141/ws/mimo
# Optional fixed token for the Mimo WebSocket bridge. If unset, a random token is generated per process.
# MIMO_WS_TOKEN=change-this-long-random-secret
# Optional idle timeout for Mimo SSE bridge in milliseconds. Defaults to 300000 (5 minutes).
# Increase this if your Mimo upstream can stay silent for longer while still processing.
# MIMO_IDLE_TIMEOUT_MS=300000

# Network proxy support
# Uncomment to enable proxy settings
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
