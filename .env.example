# Copilot API Configuration

# Server Port
PORT=4141

# Bind address. Use 127.0.0.1 when serving behind nginx; use 0.0.0.0 only if exposing directly.
# HOST=127.0.0.1

# API Key for Bearer token authentication
# If set, all API calls must include: Authorization: Bearer <API_KEY>
API_KEY=your-api-key-here

# Admin Dashboard Password
# If not set, defaults to API_KEY
# Used for /admin/login access
ADMIN_PASSWORD=your-admin-password-here

# GitHub Token (skip auth prompt if provided)
# Generate via: bunx copilot-api auth
# GITHUB_TOKEN=ghp_xxxxx

# Account Type: individual, business, or enterprise
ACCOUNT_TYPE=individual

# Enable verbose logging
VERBOSE=false

# Mimo AI Studio configuration
# The public WebSocket URL where cloud Claw containers can connect back to this instance.
# Required if you want Claw agents to tunnel requests back (e.g. wss://api.yourdomain.com/ws/mimo).
# If running locally behind tunnel/proxy, set this to the public tunnel address.
# MIMO_WS_URL=ws://localhost:4141/ws/mimo
# Optional fixed token for the Mimo WebSocket bridge. If unset, a random token is generated per process.
# MIMO_WS_TOKEN=change-this-long-random-secret
# Optional idle timeout for Mimo SSE bridge in milliseconds. Defaults to 300000 (5 minutes).
# Increase this if your Mimo upstream can stay silent for longer while still processing.
# MIMO_IDLE_TIMEOUT_MS=300000

# Network proxy support
# Uncomment to enable proxy settings
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
