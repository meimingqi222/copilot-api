# Local tooling state. These paths are gitignored, but Prettier does NOT read
# .gitignore, so without these entries `prettier --check .` reports drift in
# files no one commits (e.g. .claude/settings.local.json).
.claude/
.devin/

# Regression notes are historical records: the verifier seals archived notes,
# and the vendored templates must keep their placeholders byte-for-byte.
.agents/notes/
regression-notes/
